---
import Base from './Base.astro';

interface Props {
	title: string;
	meta: string;
	summary?: string;
}

const { title, meta, summary } = Astro.props;
---

<Base title={title}>
	<article>
		<p class="meta">{meta}</p>
		<h1>{title}</h1>
		{summary && <p class="summary">{summary}</p>}

		<div class="prose">
			<slot />
		</div>
	</article>
</Base>

<style>
	h1 {
		font-size: 1.55rem;
		font-weight: 500;
		line-height: 1.3;
		margin: 0 0 0.5rem;
	}

	.meta {
		font-family: var(--secondary);
		font-size: var(--secondary-size);
		color: var(--muted);
		margin: 0 0 0.5rem;
	}

	.summary {
		color: var(--muted);
		margin: 0 0 0.5rem;
	}

	.prose {
		margin-top: 2.5rem;
	}

	.prose :global(h2) {
		font-size: 1.1rem;
		font-weight: 500;
		margin: 2.5rem 0 0.5rem;
	}

	.prose :global(h3) {
		font-size: 1rem;
		font-weight: 500;
		margin: 2rem 0 0.5rem;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	.prose :global(code) {
		font-family: var(--code);
		font-size: 0.85em;
	}

	.prose :global(pre) {
		padding: 1rem;
		overflow-x: auto;
		font-size: 0.85rem;
	}

	.prose :global(table) {
		width: 100%;
		margin: 1.25rem 0;
		border-collapse: collapse;
		font-size: 0.9rem;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.45rem 0.5rem;
		border-bottom: 1px solid var(--rule);
		text-align: left;
	}

	.prose :global(th) {
		font-weight: 500;
	}

	.prose :global(blockquote) {
		margin: 1.5rem 0;
		padding-left: 1rem;
		border-left: 2px solid var(--accent);
		color: var(--muted);
	}
</style>
