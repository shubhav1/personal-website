---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhotoStack from '../components/PhotoStack.astro';
import ProjectVideo from '../components/ProjectVideo.astro';
import { formatDate, getFeaturedProjects, getPosts } from '../lib/content';

const projects = await getFeaturedProjects();
const posts = (await getPosts()).slice(0, 3);

// From res_maker/experiences (work only, not leadership), most recent first.
const been = [
	{
		dates: '6.26–8.26',
		role: 'Business Analyst',
		name: 'McKinsey & Company',
		url: 'https://www.mckinsey.com/',
		desc: 'Modeled battery storage feasibility for AI data centers',
	},
	{
		dates: '2.26–5.26',
		role: 'Product Manager',
		name: 'Nara',
		url: 'https://www.withnara.com/',
		desc: 'Led product for an early-stage, agentic AI home-care startup',
	},
	{
		dates: '9.25–5.26',
		role: 'Software Developer',
		name: 'Climate Resolve',
		url: 'https://climateresolve.org/',
		desc: 'Built the internal time and projects-tracking platform used by 50 staff',
	},
	{
		dates: '3.25–5.26',
		role: 'Data Analyst',
		name: 'USC Annenberg',
		url: 'https://annenberg.usc.edu/',
		desc: 'Turned 30+ budget reports into one dashboard that drove 10% in cuts',
	},
	{
		dates: '6.25–8.25',
		role: 'AI Engineer',
		name: 'Automus',
		url: 'https://automus.com/',
		desc: 'Shipped a RAG design-doc platform used by 200 employees',
	},
];

// Photos live in public/photos/, e.g. { src: '/photos/me.jpg', alt: '...' }.
const photos = [
	{ src: '/photos/headshot.jpg', alt: 'Shubha Vajragiri' },
	{ src: '/photos/photo-1.jpg', alt: 'A fluffy white dog peeking over the back of a couch' },
	{ src: '/photos/photo-2.jpg', alt: 'Sunset over a rainforest coastline and the ocean' },
	{ src: '/photos/photo-3.jpg', alt: 'Two people in formal traditional dress speaking on stage' },
	{ src: '/photos/photo-4.jpg', alt: 'Waves rolling onto a beach at sunset' },
];
---

<Base>
	<PhotoStack slot="aside" photos={photos} />
	<h1 class="name">Shubha Vajragiri</h1>

	<section>
		<div>
			<p>
				Hi! I'm Shubha, a junior at USC. I'm studying Artificial Intelligence, Applied Mathematics, and Business. <br><br>
				I spend my time learning about frontier AI systems from the ground up (how they're built, trained, and deployed). 
				I build my own implementations and experiments, read the papers, and talk to people who care about the same questions. <br><br>
				If I'm not doing that, I'm trying different cuisines (check out my <a href="https://beliapp.co/profile/shubhaa" target="_blank" rel="noopener noreferrer">Beli</a>), sewing new clothes, or driving to Laguna Beach.
			</p>
		</div>
	</section>

	<section>
		<h2 class="label">made</h2>
		<ul class="thumbs">
			{projects.map((p) => (
				<li>
					<a class="block-link" href={`/projects#${p.id}`}>
						<ProjectVideo src={p.data.video} poster={p.data.poster} image={p.data.image} label={p.data.title} />
						<span class="thumb-label">
							<span class="thumb-title sheen">{p.data.title}</span>
							{p.data.inProgress && <span class="status">in progress</span>}
						</span>
					</a>
				</li>
			))}
		</ul>
		<a class="more" href="/projects">all projects →</a>
	</section>

	{posts.length > 0 && (
		<section>
			<h2 class="label">wrote</h2>
			<ul class="rows dated">
				{posts.map((p) => (
					<li>
						<span class="year">{formatDate(p.data.date)}</span>
						<a href={`/writing/${p.id}`}>{p.data.title}</a>
					</li>
				))}
			</ul>
			<a class="more" href="/writing">all writing →</a>
		</section>
	)}

	<section>
		<h2 class="label">been</h2>
		<ul class="rows jobs">
			{been.map((r) => (
				<li>
					<span class="dates">{r.dates}</span>
					<div class="job">
						<p class="title">
							{r.role} <span class="at">@</span>{' '}<a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a>
						</p>
						<p class="desc">{r.desc}</p>
					</div>
				</li>
			))}
		</ul>
	</section>

	<section>
		<h2 class="label">elsewhere</h2>
		<p>
			let's chat! <br> 
			<a href="mailto:shubha.vajragiri@gmail.com" target="_blank" rel="noopener noreferrer"><Icon name="mail" />email</a>
			&nbsp;&nbsp;&nbsp;<a href="https://www.linkedin.com/in/shubha-vajragiri/" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" />LinkedIn</a>
			&nbsp;&nbsp;&nbsp;<a href="https://github.com/shubhav1" target="_blank" rel="noopener noreferrer"><Icon name="github" />Github</a>
		</p>
	</section>
</Base>

<style>
	/* Dates in a fixed column on the left, then "role @ company" over a one-line
	   description. */
	.jobs li {
		grid-template-columns: 3.4rem 1fr;
		align-items: baseline;
		column-gap: 0.9rem;
		padding: 0.75rem 0;
		font-size: 0.9rem;
	}

	.job {
		min-width: 0;
	}

	.jobs .title,
	.jobs .desc {
		margin: 0;
	}

	.at {
		color: var(--muted);
	}

	.desc {
		font-size: 0.78rem;
		color: var(--muted);
		margin-top: 0.15rem;
	}

	/* Keep descriptions to a single line where there's room; let them wrap on phones. */
	@media (min-width: 52rem) {
		.desc {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
	}

	.dates {
		font-family: var(--secondary);
		font-size: var(--secondary-size);
		color: var(--muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.name {
		font-size: 1.55rem;
		font-weight: 500;
		line-height: 1.2;
		margin: 0 0 1.25rem;
	}

	.thumbs {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 1.25rem 1rem;
	}

	.thumbs a {
		display: block;
		text-decoration: none;
	}

	/* Title with the status label inline after it, as on /projects. */
	.thumb-label {
		display: block;
		margin-top: 0.5rem;
		line-height: 1.3;
	}

	.thumbs a:hover .thumb-title {
		text-decoration: underline;
		text-decoration-color: var(--accent);
	}

	.thumbs .status {
		margin-left: 0.4rem;
		white-space: nowrap;
		font-family: var(--secondary);
		font-size: var(--secondary-size);
		color: var(--muted);
	}
</style>
